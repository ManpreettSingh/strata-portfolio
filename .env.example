# ─── Frontend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# All frontend env vars MUST be prefixed with VITE_ to be available in the browser.

# ── Backend API URL ──────────────────────────────────────────────────
# Purpose:  Base URL of the Folio backend API (no trailing slash).
# Format:   http(s)://host:port
# Where:    Points to your running foliobackend instance.
# Free:     N/A (your own backend)
# Default:  http://localhost:4000
VITE_API_BASE_URL="http://localhost:4000"
